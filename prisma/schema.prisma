// Todoist's projects / priorities / labels merged with Things' when-buckets and
// its separate deadline concept.
//
// Switching to Postgres for production is a two-line change: set provider to
// "postgresql" and point DATABASE_URL at the server. String-typed enums are
// deliberate — SQLite has no native enum, and keeping them as strings means the
// same schema runs on both engines. The allowed values live in
// src/lib/constants.ts and are enforced by Zod at every write.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  // Login throttling. Reset on any successful sign-in.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  /// Which view opens when the app is launched. One of VIEWS in
  /// src/lib/constants.ts.
  defaultView String @default("today")

  /// Israeli mobile in local form, "0541234567". Unique because an inbound
  /// WhatsApp message has to resolve to exactly one account — two people
  /// sharing a number would make "whose Inbox does this go to" unanswerable.
  phone           String? @unique
  /// Two switches, because they are two different consents. Letting the app
  /// turn your messages into tasks is not the same as letting it message you,
  /// and someone who wants reminders but files everything by hand — or the
  /// reverse — had no way to say so while these were one flag.
  ///
  /// Both off until asked for: a number on file is not permission for either.
  whatsappCapture   Boolean @default(false)
  whatsappReminders Boolean @default(false)
  /// Feature introduction is shown once per account, across devices.
  whatsappIntroSeenAt DateTime?

  /// The hour a reminder fires for a task that has a day but no time of its
  /// own — 0–23, Israel time. One setting for the whole account rather than a
  /// field on every task: "remind me about undated-time things in the morning"
  /// is a habit, not a per-task decision, and asking for it every time would
  /// be a question with the same answer forever.
  reminderHour Int @default(8)

  sessions    Session[]
  projects    Project[]
  tasks       Task[]
  labels      Label[]
  resetTokens PasswordResetToken[]
  comments    TaskComment[]
  savedFilters SavedFilter[]
  googleCalendar GoogleCalendarConnection?
  googleOAuthStates GoogleOAuthState[]
  calendarFeed CalendarFeed?

  /// Projects other people have let this user into.
  memberships   ProjectMember[]
  invitesSent   ProjectInvite[] @relation("InvitesSent")
  whatsappLogs  WhatsappLog[]
  /// Tasks in shared projects handed to this user. Separate from `tasks`,
  /// which is authorship: the person who wrote a task and the person doing it
  /// are usually the same and sometimes are not.
  assignedTasks Task[]          @relation("Assignee")
}

/// Same shape as Session: the emailed link carries a random token, only its
/// SHA-256 lands here, and it is deleted the moment it is used.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  // The cookie holds a random 32-byte token; only its SHA-256 is stored here,
  // so a database leak does not hand over live sessions.
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The Inbox is not a project. A task is "in the Inbox" when it has no project
/// at all — the same definition Todoist and Things use. Modelling it as a
/// project (or as a scheduling bucket) makes filing and scheduling fight each
/// other: giving an unfiled task a date would move it out of the Inbox.
model Project {
  id         String    @id @default(cuid())
  userId     String
  name       String
  color      String    @default("teal")
  position   String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections Section[]
  tasks    Task[]
  members  ProjectMember[]
  invites  ProjectInvite[]

  @@index([userId, position])
}

/// Everyone who has been let into a project, *not counting its owner* — the
/// owner is `Project.userId` and stays the single source of truth for who may
/// delete or rename it. Storing an owner row here as well would be a second
/// place for the same fact to be right or wrong.
///
/// Access to a project, and so to every task inside it, is "owner or has a row
/// here". Sharing is deliberately per project and goes no further: the Inbox
/// has no project, so it can never be shared, and personal labels stay
/// personal even on a task two people can both see.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per person per project; the invite flow relies on this to
  /// make accepting twice a no-op rather than a duplicate.
  @@unique([projectId, userId])
  @@index([userId])
}

/// An invitation to join a project.
///
/// Same shape as PasswordResetToken and Session: the link carries a random
/// token, only its SHA-256 is stored, and it is deleted the moment it is used.
/// A link rather than an email address as the primary mechanism, because this
/// app may have no SMTP configured — the address is optional and only recorded
/// when we actually sent it somewhere.
model ProjectInvite {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  projectId   String
  invitedById String
  email       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([expiresAt])
}

/// Things calls these "headings" — a titled break inside a project.
model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id        String  @id @default(cuid())
  userId    String
  projectId String?
  sectionId String?
  /// Set on checklist items; a subtask is just a Task with a parent.
  parentId  String?

  title String
  notes String?

  /// 1 = highest … 4 = none.
  priority Int    @default(4)
  /// TODO | DONE | CANCELED
  status   String @default("TODO")

  /// SCHEDULED | ANYTIME | SOMEDAY — *when*, and nothing to do with *where*.
  /// Whether a task is in the Inbox is decided by projectId being null.
  whenBucket    String    @default("ANYTIME")
  /// UTC midnight of the intended calendar day — never a local timestamp.
  scheduledFor  DateTime?
  /// "HH:mm", 24-hour. Israeli UIs do not use AM/PM.
  scheduledTime String?
  durationMinutes Int @default(30)
  /// Things' real differentiator: "do it whenever, but it is due Thursday".
  deadline      DateTime?

  completedAt DateTime?

  /// When a WhatsApp reminder actually went out. A timestamp rather than a
  /// date string, because the send loop needs to answer "how late is this
  /// one?" and refuse the ones that are hours stale — a reminder for a 09:00
  /// task delivered at 15:00 because the worker was down is worse than none.
  remindedAt DateTime?

  /// What reminder this task asked for, if it said anything.
  ///
  /// Three states in one nullable column, which is why it is a string and not
  /// an Int: `null` means "whatever the account does by default" — the state
  /// every existing row is already in, and the one that keeps following the
  /// setting when it changes. `"off"` is an explicit no. Anything else is a
  /// non-negative number of minutes before the moment the reminder is
  /// anchored to: the task's own time when it has one, otherwise
  /// `User.reminderHour` on the scheduled day.
  ///
  /// An Int could not tell "unset" from "at the exact time", and a second
  /// boolean column to disambiguate would be two places for one fact.
  reminder String?

  /// Repeat rule, serialised by lib/recurrence.ts ("weekly:1:0,3"). Null means
  /// a one-off. Completing a repeating task files a done copy in the Logbook
  /// and moves this row on to its next occurrence, so there is only ever one
  /// live instance.
  recurrence String?
  /// Set on the Logbook copies, pointing back at the live task.
  recurrenceParentId String?

  /// Who is doing it, in a shared project. Null means nobody has picked it up
  /// yet, which is different from "assigned to the owner" — an unclaimed task
  /// still shows in everyone's project view, and in nobody's Today.
  ///
  /// `userId` above is authorship and does not change; this does. In an
  /// unshared project it is always null, so it costs nothing there.
  /// SetNull rather than Cascade: removing a person from a project must
  /// unassign their tasks, never delete them.
  assigneeId String?

  /// Fractional index (see lib/ordering.ts) — reordering writes one row.
  position    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee User?       @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project  Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section  Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent   Task?       @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]      @relation("Subtasks")
  labels   TaskLabel[]
  comments TaskComment[]
  googleLinks GoogleTaskLink[]

  @@index([userId, status, scheduledFor])
  @@index([userId, status, whenBucket])
  @@index([userId, status, deadline])
  @@index([projectId, position])
  @@index([parentId])
  /// The Inbox is "projectId is null", so that lookup gets its own index.
  @@index([userId, status, projectId])
  @@index([recurrenceParentId])
  /// "What is on my plate across every shared project" is the query the Today
  /// view runs for a collaborator.
  @@index([assigneeId, status])
  /// The reminder sweep runs across every user at once, so it cannot use any
  /// of the userId-prefixed indexes above.
  @@index([status, scheduledFor, remindedAt])
}

/// Every WhatsApp message this app sent or acted on, and why it failed when it
/// did.
///
/// The `error` column is the point. The system this replaces recorded a
/// broadcast as `failed` and nothing else, so 27 of its 70 sends are
/// unexplained and unfixable after the fact.
model WhatsappLog {
  id String @id @default(cuid())

  /// Null for a message from a number that matches no account — worth keeping,
  /// because "someone messaged us and we ignored them" is the thing you want
  /// to see when a user says it did not work.
  userId String?
  /// Stored in local form, matching User.phone.
  phone  String

  /// IN | OUT
  direction String
  /// CAPTURE | REPLY | REMINDER
  kind      String
  body      String
  /// sent | failed | ignored
  status    String
  error     String?
  /// WhatsApp's message ID lets receipt updates prove delivery independently.
  messageId String? @unique
  deliveredAt DateTime?
  readAt DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Label {
  id       String   @id @default(cuid())
  userId   String
  name     String
  color    String   @default("slate")
  position String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([userId, name])
  @@index([userId, position])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  config    String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model GoogleOAuthState {
  id String @id @default(cuid())
  stateHash String @unique
  userId String
  sessionId String
  verifier String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model GoogleCalendarConnection {
  id String @id @default(cuid())
  userId String @unique
  accountEmail String
  refreshToken String
  accessToken String
  accessExpiresAt DateTime
  taskCalendarId String?
  taskSyncToken String?
  showEvents Boolean @default(true)
  syncTasks Boolean @default(true)
  syncAllDay Boolean @default(true)
  lastSyncAt DateTime?
  lastError String?
  leaseUntil DateTime?
  leaseOwner String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources GoogleCalendarSource[]
  taskLinks GoogleTaskLink[]
}

model GoogleCalendarSource {
  id String @id @default(cuid())
  connectionId String
  googleId String
  name String
  enabled Boolean @default(false)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events GoogleCalendarEvent[]
  @@unique([connectionId, googleId])
}

model GoogleCalendarEvent {
  id String @id @default(cuid())
  sourceId String
  googleId String
  title String
  startAt DateTime
  endAt DateTime
  startDay String
  endDay String
  allDay Boolean
  htmlLink String?
  location String?
  source GoogleCalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([sourceId, googleId])
  @@index([sourceId, startDay, endDay])
}

// Keep the mapping after deletion so the next sweep can remove its Google event.
model GoogleTaskLink {
  id String @id @default(cuid())
  connectionId String
  taskId String?
  eventId String
  fingerprint String
  taskUpdatedAt DateTime
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@unique([connectionId, taskId])
  @@unique([connectionId, eventId])
}

model CalendarFeed {
  id String @id @default(cuid())
  userId String @unique
  tokenHash String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
