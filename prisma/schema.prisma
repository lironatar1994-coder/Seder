// Todoist's projects / priorities / labels merged with Things' when-buckets and
// its separate deadline concept.
//
// Switching to Postgres for production is a two-line change: set provider to
// "postgresql" and point DATABASE_URL at the server. String-typed enums are
// deliberate — SQLite has no native enum, and keeping them as strings means the
// same schema runs on both engines. The allowed values live in
// src/lib/constants.ts and are enforced by Zod at every write.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  // Login throttling. Reset on any successful sign-in.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  /// Which view opens when the app is launched. One of VIEWS in
  /// src/lib/constants.ts.
  defaultView String @default("today")

  sessions    Session[]
  projects    Project[]
  tasks       Task[]
  labels      Label[]
  resetTokens PasswordResetToken[]

  /// Projects other people have let this user into.
  memberships   ProjectMember[]
  invitesSent   ProjectInvite[] @relation("InvitesSent")
  /// Tasks in shared projects handed to this user. Separate from `tasks`,
  /// which is authorship: the person who wrote a task and the person doing it
  /// are usually the same and sometimes are not.
  assignedTasks Task[]          @relation("Assignee")
}

/// Same shape as Session: the emailed link carries a random token, only its
/// SHA-256 lands here, and it is deleted the moment it is used.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  // The cookie holds a random 32-byte token; only its SHA-256 is stored here,
  // so a database leak does not hand over live sessions.
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The Inbox is not a project. A task is "in the Inbox" when it has no project
/// at all — the same definition Todoist and Things use. Modelling it as a
/// project (or as a scheduling bucket) makes filing and scheduling fight each
/// other: giving an unfiled task a date would move it out of the Inbox.
model Project {
  id         String    @id @default(cuid())
  userId     String
  name       String
  color      String    @default("teal")
  position   String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections Section[]
  tasks    Task[]
  members  ProjectMember[]
  invites  ProjectInvite[]

  @@index([userId, position])
}

/// Everyone who has been let into a project, *not counting its owner* — the
/// owner is `Project.userId` and stays the single source of truth for who may
/// delete or rename it. Storing an owner row here as well would be a second
/// place for the same fact to be right or wrong.
///
/// Access to a project, and so to every task inside it, is "owner or has a row
/// here". Sharing is deliberately per project and goes no further: the Inbox
/// has no project, so it can never be shared, and personal labels stay
/// personal even on a task two people can both see.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per person per project; the invite flow relies on this to
  /// make accepting twice a no-op rather than a duplicate.
  @@unique([projectId, userId])
  @@index([userId])
}

/// An invitation to join a project.
///
/// Same shape as PasswordResetToken and Session: the link carries a random
/// token, only its SHA-256 is stored, and it is deleted the moment it is used.
/// A link rather than an email address as the primary mechanism, because this
/// app may have no SMTP configured — the address is optional and only recorded
/// when we actually sent it somewhere.
model ProjectInvite {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  projectId   String
  invitedById String
  email       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([expiresAt])
}

/// Things calls these "headings" — a titled break inside a project.
model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id        String  @id @default(cuid())
  userId    String
  projectId String?
  sectionId String?
  /// Set on checklist items; a subtask is just a Task with a parent.
  parentId  String?

  title String
  notes String?

  /// 1 = highest … 4 = none.
  priority Int    @default(4)
  /// TODO | DONE | CANCELED
  status   String @default("TODO")

  /// SCHEDULED | ANYTIME | SOMEDAY — *when*, and nothing to do with *where*.
  /// Whether a task is in the Inbox is decided by projectId being null.
  whenBucket    String    @default("ANYTIME")
  /// UTC midnight of the intended calendar day — never a local timestamp.
  scheduledFor  DateTime?
  /// "HH:mm", 24-hour. Israeli UIs do not use AM/PM.
  scheduledTime String?
  /// Things' real differentiator: "do it whenever, but it is due Thursday".
  deadline      DateTime?

  completedAt DateTime?

  /// Repeat rule, serialised by lib/recurrence.ts ("weekly:1:0,3"). Null means
  /// a one-off. Completing a repeating task files a done copy in the Logbook
  /// and moves this row on to its next occurrence, so there is only ever one
  /// live instance.
  recurrence String?
  /// Set on the Logbook copies, pointing back at the live task.
  recurrenceParentId String?

  /// Who is doing it, in a shared project. Null means nobody has picked it up
  /// yet, which is different from "assigned to the owner" — an unclaimed task
  /// still shows in everyone's project view, and in nobody's Today.
  ///
  /// `userId` above is authorship and does not change; this does. In an
  /// unshared project it is always null, so it costs nothing there.
  /// SetNull rather than Cascade: removing a person from a project must
  /// unassign their tasks, never delete them.
  assigneeId String?

  /// Fractional index (see lib/ordering.ts) — reordering writes one row.
  position    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee User?       @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project  Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section  Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent   Task?       @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]      @relation("Subtasks")
  labels   TaskLabel[]

  @@index([userId, status, scheduledFor])
  @@index([userId, status, whenBucket])
  @@index([userId, status, deadline])
  @@index([projectId, position])
  @@index([parentId])
  /// The Inbox is "projectId is null", so that lookup gets its own index.
  @@index([userId, status, projectId])
  @@index([recurrenceParentId])
  /// "What is on my plate across every shared project" is the query the Today
  /// view runs for a collaborator.
  @@index([assigneeId, status])
}

model Label {
  id       String   @id @default(cuid())
  userId   String
  name     String
  color    String   @default("slate")
  position String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([userId, name])
  @@index([userId, position])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}
